{
  "name": "codelapse",
  "displayName": "CodeLapse",
  "description": "Records one chosen folder in VS Code and replays the work as a timelapse with session metrics",
  "version": "0.0.1",
  "publisher": "shanthan2307",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shanthan2307/Codelapse_ext.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codelapse.startSession",
        "title": "CodeLapse: Start Recording Session"
      },
      {
        "command": "codelapse.selectFolder",
        "title": "CodeLapse: Choose Folder to Record"
      },
      {
        "command": "codelapse.stopSession",
        "title": "CodeLapse: Stop Recording Session"
      },
      {
        "command": "codelapse.showReport",
        "title": "CodeLapse: Show Session Report & Analytics"
      },
      {
        "command": "codelapse.exportHtmlReport",
        "title": "CodeLapse: Export Standalone HTML Report"
      },
      {
        "command": "codelapse.exportBundle",
        "title": "CodeLapse: Export Assignment Bundle (.codelapse)"
      },
      {
        "command": "codelapse.exportForSubmission",
        "title": "CodeLapse: Save Session Data to Folder"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codelapse.selectFolder",
          "when": "explorerResourceIsFolder",
          "group": "z_codelapse"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "mocha -r ts-node/register 'src/test/suite/**/*.test.ts' 'packages/*/test/**/*.test.ts'",
    "test:integration": "npm run compile && node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.integration.json && node out/src/test/runIntegration.js",
    "lint": "eslint src packages",
    "typecheck": "tsc --noEmit -p .",
    "package": "vsce package --no-dependencies",
    "fixtures": "npm run compile && node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.integration.json && CODELAPSE_SUITE=fixtures node out/src/test/runIntegration.js"
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@codelapse/core": "0.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^14.0.3",
    "mocha": "^12.0.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
